{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$other": { ".validate": false },
        "asks": {
          "$session": {
            "$ask": {
              ".validate": "!newData.exists() || (newData.child('v').val() == 1 && newData.hasChildren(['tool', 'detail', 'session', 'createdAt', 'status']))",
              "v": { ".validate": "newData.isNumber()" },
              "tool": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "detail": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "why": { ".validate": "newData.isString() && newData.val().length <= 120" },
              "session": { ".validate": "newData.isString() && newData.val().length <= 120" },
              "createdAt": { ".validate": "newData.isNumber()" },
              "status": { ".validate": "newData.isString() && newData.val().matches(/^(pending|allowed|denied|expired)$/)" },
              "answeredBy": { ".validate": "newData.isString() && newData.val().matches(/^(app|terminal)$/)" },
              "answer": { ".validate": "newData.isString() && newData.val().matches(/^(allow|deny)$/) && !data.exists() && data.parent().child('status').val() == 'pending'" },
              "$other": { ".validate": false }
            }
          }
        },
        "cmd": {
          "$session": {
            "$cmd": {
              ".validate": "!newData.exists() || (newData.child('v').val() == 1 && newData.hasChildren(['target', 'text', 'createdAt', 'status']))",
              "v": { ".validate": "newData.isNumber()" },
              "target": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40 && (!data.exists() || data.val() == newData.val())" },
              "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500 && (!data.exists() || data.val() == newData.val())" },
              "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || data.val() == newData.val())" },
              "status": { ".validate": "newData.isString() && newData.val().matches(/^(queued|delivered|failed)$/) && ((!data.exists() && newData.val() == 'queued') || (data.exists() && (data.val() == newData.val() || (data.val() == 'queued' && newData.val() != 'queued'))))" },
              "quick": { ".validate": "newData.isString() && newData.val().matches(/^(pause|continue|stop|status)$/)" },
              "note": { ".validate": "newData.isString() && newData.val().length <= 80 && newData.parent().child('status').val() != 'queued'" },
              "deliveredAt": { ".validate": "newData.isNumber() && newData.parent().child('status').val() != 'queued'" },
              "$other": { ".validate": false }
            }
          }
        },
        "prefs": {
          "appAsk": { ".validate": "newData.isBoolean()" },
          "appCmd": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "live": {
          "$session": {
            ".validate": "!newData.exists() || (newData.child('v').val() == 1 && newData.hasChildren(['project', 'session', 'status', 'seenAt']))",
            "v": { ".validate": "newData.isNumber()" },
            "project": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "title": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "session": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "status": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "host": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "seenAt": { ".validate": "newData.isNumber()" },
            "firstSeen": { ".validate": "newData.isNumber()" },
            "main": { "$k": { ".validate": "(newData.isString() && newData.val().length <= 60) || newData.isNumber() || newData.isBoolean()" } },
            "meter": {
              "limits": {
                "$i": { ".validate": "$i.matches(/^[0-3]$/)", "$k": { ".validate": "(newData.isString() && newData.val().length <= 20) || newData.isNumber()" } }
              },
              "$k": { ".validate": "(newData.isString() && newData.val().length <= 60) || newData.isNumber() || newData.isBoolean()" }
            },
            "flow": { "$k": { ".validate": "(newData.isString() && newData.val().length <= 80) || newData.isNumber() || newData.isBoolean()" } },
            "gate": { "$k": { ".validate": "newData.isNumber()" } },
            "agents": {
              "$i": { ".validate": "$i.matches(/^([0-9]|1[0-9]|2[0-3])$/)", "$k": { ".validate": "(newData.isString() && newData.val().length <= 200) || newData.isNumber() || newData.isBoolean()" } }
            },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "live": {
      ".read": "auth != null && auth.uid === 'MPEdWykUOaUYDi3SAYcTmBVdpfA2'",
      "$session": {
        ".write": "auth != null && auth.uid === 'MPEdWykUOaUYDi3SAYcTmBVdpfA2'",
        ".validate": "!newData.exists() || (newData.child('v').val() == 1 && newData.hasChildren(['project', 'session', 'status', 'seenAt']))"
      }
    }
  }
}

