{
  "database": {
    "instance": "my-mod-7160b-default-rtdb",
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "my-mod-7160b",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "database": {
      "port": 9000
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": false
  }
}